# Replit run configuration for deRek AI OS (API).
# The dashboard is a separate Vite app - run it with `npm run dev`
# inside apps/dashboard, or deploy it as a static site.

run = "bash tools_run_api.sh"
entrypoint = "apps/api/main.py"

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 8000
externalPort = 80

[deployment]
run = ["bash", "tools_run_api.sh"]
deploymentTarget = "cloudrun"
